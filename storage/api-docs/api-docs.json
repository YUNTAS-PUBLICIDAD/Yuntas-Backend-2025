        "/api/admin/templates": {
            "get": {
                "tags": [
                    "Templates"
                ],
                "summary": "Listar templates",
                "operationId": "67a0540064adec74c1c77f8248e93db6",
                "responses": {
                    "200": {
                        "description": "Lista de templates",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "integer"
                                            },
                                            "name": {
                                                "type": "string"
                                            },
                                            "active": {
                                                "type": "boolean"
                                            },
                                            "contents": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/components/schemas/TemplateContent"
                                                }
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Templates"
                ],
                "summary": "Crear template",
                "operationId": "df08370eb895e2dc260080b71cb212e0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "lead_source_id",
                                    "name",
                                    "active"
                                ],
                                "properties": {
                                    "lead_source_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Template bienvenida"
                                    },
                                    "active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "contents": {
                                        "description": "Enviar como contents[0][field]. Ej: contents[0][channel]",
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/TemplateContent"
                                        }
                                    },
                                    "contents[0][channel]": {
                                        "type": "string",
                                        "example": "whatsapp"
                                    },
                                    "contents[0][subject]": {
                                        "type": "string",
                                        "example": "Promo"
                                    },
                                    "contents[0][content]": {
                                        "type": "string",
                                        "example": "Hola {{name}}"
                                    },
                                    "contents[0][active]": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "contents[0][image]": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Template creado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
