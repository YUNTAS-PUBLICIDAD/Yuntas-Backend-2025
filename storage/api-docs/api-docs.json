                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Nuevo título"
                                    },
                                    "button_text": {
                                        "type": "string",
                                        "example": "Comprar"
                                    },
                                    "button_color": {
                                        "type": "string",
                                        "example": "#000000"
                                    },
                                    "page_target": {
                                        "type": "string",
