                ],
                "summary": "Actualizar template",
                "operationId": "9f88d960babdfe262630f6d91324ba52",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "active": {
                                        "type": "boolean"
                                    },
                                    "contents": {
                                        "description": "Actualizar o crear contenidos usando contents[index][field]",
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/TemplateContent"
                                        }
                                    },
                                    "contents[0][id]": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "contents[0][channel]": {
                                        "type": "string"
                                    },
                                    "contents[0][content]": {
                                        "type": "string"
                                    },
                                    "contents[0][active]": {
                                        "type": "boolean"
                                    },
                                    "contents[0][image]": {
