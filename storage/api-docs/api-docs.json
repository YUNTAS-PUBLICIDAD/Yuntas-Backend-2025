{
    "openapi": "3.0.0",
    "info": {
        "title": "Documentación API - Yuntas Backend 2025",
        "description": "API oficial del sistema Yuntas",
        "contact": {
            "email": "your-email@gmail.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/admin/popup-images/{id}": {
            "patch": {
                "tags": [
                    "PopupImages"
                ],
                "summary": "Actualizar una imagen de popup (parcial)",
                "description": "Permite actualizar imagen, device, slot, alt o title de forma independiente",
                "operationId": "updatePopupImage",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID de la imagen",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "file": {
                                        "description": "Nueva imagen",
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "device": {
                                        "type": "string",
                                        "enum": [
                                            "desktop",
                                            "mobile"
                                        ]
                                    },
                                    "slot": {
                                        "type": "string",
                                        "enum": [
                                            "left",
                                            "right",
                                            "center"
                                        ]
                                    },
                                    "alt": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "title": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Imagen actualizada correctamente"
                    },
                    "422": {
                        "description": "Error de validación o reglas de negocio"
                    },
                    "404": {
                        "description": "Imagen no encontrada"
                    }
                }
            }
        },
        "/api/admin/popups": {
            "get": {
                "tags": [
                    "Popups"
                ],
                "summary": "Obtener todos los popups",
                "operationId": "48b1414bed571a8cdd4ea91f850ad321",
                "responses": {
                    "200": {
                        "description": "Lista de popups"
                    }
                }
            },
            "post": {
                "tags": [
                    "Popups"
                ],
                "summary": "Crear popup",
                "operationId": "c9d251bdefe07b2cf152f3d72da420f9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "lead_source_id",
                                    "title",
                                    "button_text",
                                    "page_target",
                                    "delay_seconds",
                                    "priority",
                                    "images"
                                ],
                                "properties": {
                                    "lead_source_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Popup de prueba"
                                    },
                                    "button_text": {
                                        "type": "string",
                                        "example": "Aceptar"
                                    },
                                    "button_color": {
                                        "type": "string",
                                        "example": "#f54927"
                                    },
                                    "page_target": {
                                        "type": "string",
                                        "example": "inicio"
                                    },
                                    "delay_seconds": {
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "priority": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "images": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "file",
                                                "device",
                                                "slot"
                                            ],
                                            "properties": {
                                                "file": {
                                                    "type": "string",
                                                    "format": "binary"
                                                },
                                                "device": {
                                                    "type": "string",
                                                    "enum": [
                                                        "desktop",
                                                        "mobile"
                                                    ],
                                                    "example": "desktop"
                                                },
                                                "slot": {
                                                    "type": "string",
                                                    "enum": [
                                                        "left",
                                                        "right",
                                                        "center"
                                                    ],
                                                    "example": "left"
                                                },
                                                "alt": {
                                                    "type": "string",
                                                    "example": "Imagen izquierda"
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "Promo izquierda"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Popup creado correctamente"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
