    "components": {
        "schemas": {
            "Product": {
                "title": "Producto",
                "description": "Modelo del producto dentro del sistema",
                "required": [
                    "name",
                    "slug",
                    "price",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Laptop Lenovo Ideapad"
                    },
                    "slug": {
                        "type": "string",
                        "example": "laptop-lenovo-ideapad"
                    },
                    "description": {
                        "type": "string",
                        "example": "Laptop con procesador AMD Ryzen..."
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 2599.9
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "meta_title": {
                        "type": "string",
                        "example": "Laptop Lenovo - Oferta"
                    },
                    "meta_description": {
                        "type": "string",
                        "example": "Mejor laptop calidad-precio"
                    },
                    "keywords": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "laptop",
                            "lenovo",
                            "computadora"
                        ]
                    }
                },
                "type": "object"
            },
            "TemplateContent": {
                "required": [
                    "channel",
                    "content",
                    "active"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "channel": {
                        "type": "string",
                        "example": "whatsapp"
                    },
                    "subject": {
                        "type": "string",
                        "example": "Promoción"
                    },
                    "content": {
                        "type": "string",
                        "example": "Hola {{name}}"
                    },
                    "variables": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "image_url": {
                        "type": "string",
                        "example": "/storage/plantillas/img.png"
                    },
                    "active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Productos",
            "description": "Endpoints para gestión de productos"
        },
