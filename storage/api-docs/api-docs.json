                                    },
                                    "delay_seconds": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "priority": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Popup actualizado"
                    },
                    "404": {
                        "description": "No encontrado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/popups": {
            "get": {
                "tags": [
                    "Popups"
                ],
                "summary": "Obtener popup activo por página",
                "operationId": "f0aab26071e60f63e9ae6e779b994a73",
                "parameters": [
                    {
                        "name": "page",
